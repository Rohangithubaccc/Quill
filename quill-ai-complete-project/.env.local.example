# ============================================================
# Quill.AI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git (it's already in .gitignore).
#
# This file is organized by REQUIREMENT LEVEL, not by service —
# see the setup guide for the order to actually create accounts in.
#   [REQUIRED]        — app will not start/build without these
#   [REQUIRED FOR X]   — only needed once you set up feature X
#   [OPTIONAL]         — app works without it; feature degrades gracefully
# ============================================================


# ───────────────────────────────────────────────────────────
# [REQUIRED] Supabase — database, auth, storage
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ───────────────────────────────────────────────────────────
# [REQUIRED] Platform AI provider — powers AI generation for
# every workspace that hasn't configured its own BYOK key.
# Provider-agnostic: set PLATFORM_AI_PROVIDER to 'anthropic' or
# 'openai_compatible'. The latter works with OpenAI, Google Gemini
# (its official OpenAI-compatible endpoint), NVIDIA NIM, Groq,
# Together, or any other provider that speaks the standard
# /v1/chat/completions protocol — set PLATFORM_AI_BASE_URL to
# that provider's endpoint. Individual workspaces can still
# override this entirely via Settings → API Keys (BYOK).
# ───────────────────────────────────────────────────────────
PLATFORM_AI_PROVIDER=anthropic
PLATFORM_AI_API_KEY=sk-ant-api03-...
PLATFORM_AI_MODEL=claude-sonnet-4-20250514
# Only required when PLATFORM_AI_PROVIDER=openai_compatible:
# PLATFORM_AI_BASE_URL=https://api.openai.com/v1


# ───────────────────────────────────────────────────────────
# [REQUIRED] App URL + security secrets
# ───────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000

# Used to encrypt OAuth tokens and webhook secrets at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=...

# Passed as the x-cron-secret header on all /api/cron/* routes.
# Generate: openssl rand -hex 32
CRON_SECRET=...


# ───────────────────────────────────────────────────────────
# [REQUIRED FOR BILLING] Stripe
# ───────────────────────────────────────────────────────────
# NOTE: each price ID below is needed in BOTH a server-only form
# (read by the webhook to map incoming subscriptions to a plan)
# AND a NEXT_PUBLIC_ form (read client-side to know which price
# to send when the user clicks "Upgrade"). Set the SAME value
# in both — this is not a typo, both are genuinely required.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

STRIPE_STARTER_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_GROWTH_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_AGENCY_PRICE_ID=price_...

# One-time credit top-up packs (Prices must be created as ONE-TIME,
# not recurring, in the Stripe Dashboard)
STRIPE_ADDON_SMALL_PRICE_ID=price_...
STRIPE_ADDON_MEDIUM_PRICE_ID=price_...
STRIPE_ADDON_LARGE_PRICE_ID=price_...

# NOTE: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is intentionally NOT listed —
# checkout is entirely server-side (redirect to a Stripe-hosted Checkout
# Session URL), so no client-side Stripe.js / publishable key is used
# anywhere in this codebase.


# ───────────────────────────────────────────────────────────
# [REQUIRED FOR EMAIL] Resend
# ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com


# ───────────────────────────────────────────────────────────
# [REQUIRED FOR RATE LIMITING] Upstash Redis
# ───────────────────────────────────────────────────────────
# The app runs without this (rate limiters lazily no-op if unset),
# but production should always have this configured.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...


# ───────────────────────────────────────────────────────────
# [REQUIRED FOR BACKGROUND JOBS] Inngest
# ───────────────────────────────────────────────────────────
# Powers: async image generation, bulk repurpose, webhook retry delivery.
# For LOCAL DEV: run `npx inngest-cli@latest dev` in a separate terminal —
# no env vars needed locally, the Inngest Dev Server runs on its own.
# For PRODUCTION: install the Inngest Vercel integration, which sets
# these two automatically. (They are read internally by the `inngest`
# SDK itself, not referenced explicitly anywhere in this codebase — that
# is expected, not a bug.)
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...


# ───────────────────────────────────────────────────────────
# [OPTIONAL] OpenAI — DALL-E 3 header image generation
# ───────────────────────────────────────────────────────────
# Without this, the "Generate image" button returns a clear 503 error;
# nothing else breaks.
# Cost: ~$0.04/image at 1792×1024 standard quality.
OPENAI_API_KEY=sk-...


# ───────────────────────────────────────────────────────────
# [OPTIONAL] Publishing integrations
# ───────────────────────────────────────────────────────────

# Buffer OAuth — buffer.com/developers
BUFFER_CLIENT_ID=...
BUFFER_CLIENT_SECRET=...

# LinkedIn OAuth — developer.linkedin.com
# Required app products: "Sign In with LinkedIn (OpenID Connect)" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...

# Google Search Console OAuth — console.cloud.google.com
# Enable: "Google Search Console API"
# Redirect URI: {NEXT_PUBLIC_URL}/api/integrations/gsc/callback
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...


# ───────────────────────────────────────────────────────────
# [OPTIONAL] Plagiarism / AI-detection — Originality.ai
# ───────────────────────────────────────────────────────────
# Without this, the plagiarism-check button returns a clear 503 error.
ORIGINALITY_API_KEY=...


# ───────────────────────────────────────────────────────────
# [OPTIONAL] Malware scanning for Knowledge Base uploads — VirusTotal
# ───────────────────────────────────────────────────────────
# Free tier: 500 requests/day, 4/minute at virustotal.com/gui/join-us.
# Without this, uploads are still validated by file signature (magic
# bytes) and file-type allowlist, but not scanned for known malware —
# see the Security pass section of this guide for what that does and
# doesn't cover.
VIRUSTOTAL_API_KEY=...


# ───────────────────────────────────────────────────────────
# [OPTIONAL] Analyzer real trend data — News API
# ───────────────────────────────────────────────────────────
# Free tier: 100 requests/day at newsapi.org.
# If NEWS_API_KEY is unset, the Analyzer just skips this one data
# source gracefully (Google Trends + Reddit still work).
NEWS_API_KEY=...
# Soft daily request cap enforced via Redis (defaults to 80 if unset —
# intentional headroom below the 100/day free-tier ceiling).
NEWS_API_DAILY_LIMIT=80


# ───────────────────────────────────────────────────────────
# [OPTIONAL] Agency white-label custom domains — Vercel API
# ───────────────────────────────────────────────────────────
# Token: vercel.com/account/tokens (needs project write access)
# Project ID: Vercel dashboard → your project → Settings → General
VERCEL_API_TOKEN=...
VERCEL_PROJECT_ID=prj_...
# Prevents Agency customers from registering a subdomain of your own
# production domain as their "custom" domain.
NEXT_PUBLIC_APP_DOMAIN=yourdomain.com


# ───────────────────────────────────────────────────────────
# [OPTIONAL] Error monitoring — Sentry
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# Build-time only — used by the Sentry Next.js webpack plugin
# (in next.config.js) to upload source maps. Not read anywhere in
# application code directly; the build still succeeds without it,
# just without source-map upload.
SENTRY_AUTH_TOKEN=sntrys_...


# ───────────────────────────────────────────────────────────
# [OPTIONAL] Product analytics — PostHog
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
