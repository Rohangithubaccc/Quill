# ============================================================
# Quill.AI — .gitignore
#
# No .gitignore existed in the codebase prior to this — found while
# preparing for Stage 2 (Vercel deploy) live-infrastructure testing.
# Without this, `git add .` would stage .env.local (real secrets:
# SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, STRIPE_SECRET_KEY,
# ENCRYPTION_KEY, CRON_SECRET, etc. once filled in), node_modules/,
# the .next/ build output, and a 2.4MB tsconfig.tsbuildinfo cache file.
# ============================================================

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env files — NEVER commit real secrets. .env.example is intentionally
# tracked (it has no real values); everything else is not.
.env
.env*.local
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.vscode/*
!.vscode/extensions.json
.idea
