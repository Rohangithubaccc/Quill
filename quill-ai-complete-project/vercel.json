{
  "crons": [
    {
      "path": "/api/cron/reset-usage",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/email/trial-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/linkedin-token-reminder",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/verify-domains",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/cleanup-stripe-events",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/aggregate-engagement",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/purge-deleted-workspaces",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-deleted-content",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
